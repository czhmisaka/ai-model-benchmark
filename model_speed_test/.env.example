# AI模型速度测试框架 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# MiniMax API Key
MINIMAX_API_KEY=your_api_key_here

# OpenAI API Key (如使用)
OPENAI_API_KEY=your_api_key_here

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 测试配置
TEST_ROUNDS=10
TEST_INTERVAL=1
MAX_CONCURRENT=3

# Web API 认证密钥（为空时不启用认证，兼容开发环境）
WEB_API_KEY=

# CORS 允许的来源（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Webhook Secret 加密密钥（用于加密存储 Webhook Secret）
WEBHOOK_SECRET_KEY=
