      "id": "tc_ontology_1",
      "name": "本体生成 - 小说文本案例",
      "type": "ontology_generation",
      "description": "测试模型设计知识图谱本体的能力 - 小说文本",
      "enabled": true,
      "prompt": null,
      "max_tokens": 4096,
      "temperature": 0.3,
      "stream": true,
      "system_prompt": "你是一个专业的知识图谱本体设计专家...",
      "messages": [
        {
          "role": "user",
          "content": "## 模拟需求\n\n我想知道主角的动机和下一步可能的行为\n\n## 文档内容\n\n# 第九章：离别\n\n*2038年10月·河北*"
        }
      ],
      "metadata": {
        "expected_output_type": "json",
        "complexity": "high"
      }
    },
    {
      "id": "tc_ontology_2",
